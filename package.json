{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "content:export": "node scripts/export-content.mjs",
    "content:check": "node scripts/export-content.mjs --check",
    "verify": "node scripts/verify-build.mjs",
    "test": "node scripts/test-content-pipeline.mjs",
    "test:pipeline": "node scripts/test-content-pipeline.mjs",
    "test:static": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/google.maps": "^3.66.4",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
