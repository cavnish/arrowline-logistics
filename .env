# ============================================================
# ARROWLINE LOGISTICS - FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to `.env` and fill in your real values.
# ============================================================

# URL of the Arrowline backend API (see /server folder)
# Leave empty to use the frontend's mock mode (no DB, no emails).
# Local dev example:  http://localhost:5000
# Production example: https://api.arrowlinelogistics.in
VITE_API_URL=http://localhost:5000

# Google Analytics measurement ID (optional)
VITE_GA_ID=

# reCAPTCHA v3 site key (optional — for production spam protection)
VITE_RECAPTCHA_SITE_KEY=