# ============================================================
# ARROWLINE LOGISTICS — BACKEND (server/.env) TEMPLATE
# ============================================================
# Copy this file to `server/.env` and fill in real values.
# Never commit `.env`. All of these variables are SERVER-SIDE ONLY —
# none of them may be exposed to the browser through VITE_*.
#
# The API server itself reads ONLY the values below; the optional
# SUPABASE_PROJECT_REF / SUPABASE_DB_PASSWORD / DATABASE_URL at the bottom are
# used solely by offline diagnostic scripts in server/scripts/*.
# ============================================================

# Port the Express app listens on. Render injects `PORT` automatically in
# production; the default below is only for local development.
PORT=5000

# Comma-separated list of allowed browser origins (no trailing slash).
# Include BOTH local and production frontends:
#   - Local dev:    http://localhost:5173
#   - Vercel:       https://YOUR-VERCEL-DOMAIN.vercel.app
#   - Legacy:       https://www.arrowlinelogistics.in,https://arrowlinelogistics.in
CORS_ORIGIN=http://localhost:5173,https://YOUR-VERCEL-DOMAIN.vercel.app,https://www.arrowlinelogistics.in,https://arrowlinelogistics.in

# ---------- SUPABASE (backend only — service role, never expose to the browser) ----------
SUPABASE_URL=https://vsbircholpdlhyznlrgi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------- RESEND EMAIL ----------
# REQUIRED for lead form emails. The domain in FROM_EMAIL must be verified in
# the Resend dashboard (Settings > Domains) — until then, sends are rejected
# (HTTP 403) and emailSent reports false even though the lead is stored.
# While verifying, use the Resend sandbox: "Arrowline <onboarding@resend.dev>"
RESEND_API_KEY=re_your_key
FROM_EMAIL=Arrowline Logistics <no-reply@arrowlinelogistics.in>

# Comma-separated team emails that receive every new-inquiry alert
NOTIFY_EMAILS=mundra@arrowlinelogistics.in

# ---------- AUTH ----------
# Admin login uses Supabase Auth (email + password) plus a revocable
# server-side session registry in public.admin_sessions.
#
# JWT signing secret (>= 32 chars, keep secret). Used to sign and verify the
# httpOnly admin cookie. NOT a login password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# Primary admin email. MUST exist as a CONFIRMED Supabase Auth user in the
# project from SUPABASE_URL (Dashboard -> Authentication -> Users).
ADMIN_EMAIL=web.grow.india07@gmail.com

# OPTIONAL: comma-separated secondary admin emails.
# Each must also exist as a confirmed Supabase Auth user.
ADMIN_EMAILS=

# ---------- CLOUDINARY (admin image uploads) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- OPTIONAL: diagnostic scripts in server/scripts/* ----------
# Only needed to run apply_migration.js / seed_all_services.js (DATABASE_URL)
# or scan_regions.js / test_pg.js (SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD).
# The live API server itself uses only SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_PROJECT_REF=vsbircholpdlhyznlrgi
SUPABASE_DB_PASSWORD=your-database-password
# Pooler connection string (find it in Supabase Dashboard -> Project Settings -> Database)
DATABASE_URL=postgresql://postgres.your_project_ref:your_database_password@aws-0-<region>.pooler.supabase.com:6543/postgres