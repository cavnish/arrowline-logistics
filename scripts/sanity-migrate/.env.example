# Sanity content migration — server-side secrets. Never commit real values.
# Copy to scripts/sanity-migrate/.env

# Source of truth for the migration (read-only recommended).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Destination Sanity project.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
# Editor token — required for --write (uploads images + writes documents).
SANITY_MIGRATION_TOKEN=

# Optional: where to write the exported dump + asset cache.
# Defaults to ./dump
MIGRATION_DUMP_DIR=
