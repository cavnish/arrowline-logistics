# Public website (Next.js) — browser-safe values are NEXT_PUBLIC_*.
# Copy to apps/web/.env.local. Never commit real values.

# ---- Sanity (content reads) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only: draft/preview reads (optional until preview mode is enabled)
SANITY_API_READ_TOKEN=

# Server-only: must match the Sanity webhook secret for /api/revalidate
SANITY_REVALIDATE_SECRET=

# ---- Private API (Express + Supabase + Resend) ----
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://arrowlinelogistics.in
