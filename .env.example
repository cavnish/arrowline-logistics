# ============================================================
# ARROWLINE LOGISTICS — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to `.env` and fill in your real values.
# Never commit real secrets to version control.
# NEVER commit `.env` — it is git-ignored.
#
# Two environment files exist:
#   1. ROOT .env            -> frontend (VITE_* only, baked into the bundle)
#   2. server/.env          -> Express backend (ALL secrets, server-side only)
#      NOTE: the backend reads server/.env relative to its own source
#      directory, so the working directory does not matter.
# ============================================================

# ---------- FRONTEND (safe for browser exposure) ----------
# Base URL of the Arrowline Express API.
#
# LOCAL DEVELOPMENT (Vite dev server on :5173 -> Express on :5000):
#   VITE_API_URL=http://localhost:5000
#
# PRODUCTION (Vercel frontend -> Render backend). Set this in the Vercel
# project settings, e.g.:
#   VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
#
# If left empty in a production build, the bundle talks to the SAME origin
# (/api/*) — the legacy "Express serves dist/" model. Never hardcode a
# Vercel/Render URL inside React components; always go through this variable.
VITE_API_URL=http://localhost:5000

# Google Analytics measurement ID (optional)
VITE_GA_ID=

# Google Maps API key (browser-safe, REQUIRES console restrictions).
# Powers live Directions routing + Places Autocomplete in the Transit Time
# Estimator. In the Google Cloud Console restrict this key to:
#   * APIs:  Maps JavaScript API, Places API, Directions API
#   * HTTP referrers: https://arrowlinelogistics.in/*  (+ localhost:5173/* locally)
# VITE_* values ship in the public bundle so they are never secrets — the
# referrer restriction is the real protection. Leave blank to fall back to
# Arrowline's offline hub/network model.
VITE_GOOGLE_MAPS_API_KEY=

# ---------- BUILD-TIME CONTENT EXPORT (Vercel build env only) ----------
# The build exports PUBLISHED Supabase rows into src/data/content-snapshot.json.
# These are server-side build variables, never VITE_* (they must not reach the
# browser). Configure them in Vercel > Project > Settings > Environment
# Variables for the Production environment.
#
# CONTENT_EXPORT_STRICT=1  require a fresh live export; fail the deployment
#                          (keeping the previous version live) if Supabase is
#                          unreachable or the data is invalid. Use this for the
#                          admin "Publish" workflow.
# CONTENT_EXPORT_LIVE=1    soft live export; reuse the last valid committed
#                          snapshot if Supabase is unavailable.
# (unset)                  validate and reuse the committed snapshot only.
# CONTENT_EXPORT_STRICT=1
# CONTENT_EXPORT_LIVE=1
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   (server-only; never VITE_*)

# ---------- BACKEND (server/.env - see server/.env.example) ----------
# NODE_ENV=development|production
# PORT=5000                     (Render injects PORT automatically)
# CORS_ORIGIN=http://localhost:5173,https://YOUR-VERCEL-DOMAIN.vercel.app
# JWT secret used to sign the admin cookie:
# ADMIN_API_KEY=replace-with-at-least-32-random-characters
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_EMAILS=
# Vercel Deploy Hook used by the admin Publish button (server-only; never VITE_*):
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-id
# Public site used to read the deployed content-version marker for the admin
# Publish panel. Defaults to https://arrowlinelogistics.in when unset.
# PUBLIC_SITE_URL=https://arrowlinelogistics.in

# ---------- SUPABASE ----------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=    (backend only — NEVER expose to the browser)

# ---------- RESEND EMAIL ----------
# RESEND_API_KEY=re_your_key    (backend only)
# Business sender for all outgoing enquiry emails (domain must be verified in
# Resend). Reply-To of the customer confirmation is its bare address.
# RESEND_FROM_EMAIL=Arrowline Logistics <mundra@arrowlinelogistics.in>
# Business inbox receiving every new enquiry notification (Reply-To = customer).
# LEAD_NOTIFICATION_EMAIL=mundra@arrowlinelogistics.in
# Legacy fallbacks (older deploys only; the two variables above take precedence):
# FROM_EMAIL=Arrowline Logistics <no-reply@arrowlinelogistics.in>
# NOTIFY_EMAILS=mundra@arrowlinelogistics.in

# ---------- CLOUDINARY ----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=        (backend only — NEVER expose to the browser)

# ---------- OPTIONAL DIAGNOSTIC SCRIPTS ----------
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=