# ============================================================
# ARROWLINE LOGISTICS — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your real values.
# Never commit real secrets to version control.
# NOTE: The Express backend reads server/.env (resolved relative to
# its own source directory — the working directory does not matter).
# The VITE_* values below must live in the ROOT .env for the frontend build.
# ============================================================

# ---------- FRONTEND (safe for browser exposure) ----------
# The browser reads all public data through the Express API. Leave VITE_API_URL
# empty in production so the frontend uses same-origin /api/* routes.
VITE_API_URL=
VITE_GA_ID=

# ---------- BACKEND ----------
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://your-domain.com
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=your-admin@example.com
ADMIN_EMAILS=

# ---------- SUPABASE ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- RESEND EMAIL ----------
# REQUIRED for the lead form emails. The domain used in FROM_EMAIL MUST be
# verified in the Resend dashboard (Settings > Domains) — until it is, Resend
# rejects sends (HTTP 403) and the site reports emailSent:false even though the
# lead is stored. While verifying, use the Resend sandbox sender
# "Acme <onboarding@resend.dev>" which only delivers to your own inbox.
RESEND_API_KEY=re_your_key
FROM_EMAIL=Arrowline Logistics <no-reply@arrowlinelogistics.in>
# Comma-separated team inboxes that receive the internal "new inquiry" alert.
NOTIFY_EMAILS=mundra@arrowlinelogistics.in

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- OPTIONAL DIAGNOSTIC SCRIPTS ----------
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
