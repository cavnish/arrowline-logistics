# ============================================================
# ARROWLINE LOGISTICS — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your real values.
# Never commit real secrets to version control.
# NOTE: The Express backend reads server/.env (resolved relative to
# its own source directory — the working directory does not matter).
# The VITE_* values below must live in the ROOT .env for the frontend build.
# ============================================================

# ---------- FRONTEND (safe for browser exposure) ----------
# The browser reads all public data through the Express API. Leave VITE_API_URL
# empty in production so the frontend uses same-origin /api/* routes.
VITE_API_URL=
VITE_GA_ID=
VITE_RECAPTCHA_SITE_KEY=

# ---------- BACKEND ----------
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://www.arrowlinelogistics.in
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=ops@example.com,manager@example.com

# ---------- SUPABASE ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- RESEND EMAIL ----------
RESEND_API_KEY=
FROM_EMAIL=Arrowline Logistics <verified@arrowlinelogistics.in>
NOTIFY_EMAILS=operations@arrowlinelogistics.in

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- OPTIONAL DIAGNOSTIC SCRIPTS ----------
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
